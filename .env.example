# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — Project Settings → API → service_role (keep this secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pooled connection — Project Settings → Database → Connection pooling (port 6543)
# Used at runtime by the app (PgBouncer, prepare=false)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Direct connection — Project Settings → Database → Session mode (port 5432)
# Used by drizzle-kit for migrations only (bypasses pooler)
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
